{
  "name": "@napplelets/notepad",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 3002 --strictPort",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "verify": "pnpm test && pnpm type-check && pnpm build",
    "test:conformance": "pnpm build && napplet-conformance ./dist",
    "test:conformance:ui": "napplet-conformance --ui . --exec \"vite build --watch\""
  },
  "dependencies": {
    "@napplelets/theme-xp": "workspace:*",
    "@napplet/sdk": "^0.28.0"
  },
  "devDependencies": {
    "@napplet/conformance-cli": "^0.2.19",
    "@napplet/vite-plugin": "^0.14.1",
    "jsdom": "^30.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^5.0.3"
  }
}
