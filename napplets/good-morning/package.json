{
  "name": "@napplelets/good-morning",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "type-check": "tsc --noEmit",
    "verify": "pnpm test && pnpm type-check && pnpm build",
    "test": "vitest run",
    "test:conformance": "pnpm build && napplet-conformance ./dist",
    "test:conformance:ui": "napplet-conformance --ui . --exec \"vite build --watch\""
  },
  "dependencies": {
    "@napplelets/theme-hypr": "workspace:*",
    "@napplet/sdk": "^0.28.0",
    "applesauce-common": "^6.2.0",
    "nostr-tools": "2.25.2",
    "svelte": "^5.57.1",
    "timeago.js": "4.0.2"
  },
  "devDependencies": {
    "@napplet/vite-plugin": "^0.14.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@unocss/vite": "^66.10.5",
    "jsdom": "^30.1.1",
    "typescript": "^7.0.2",
    "unocss": "^66.10.5",
    "vite": "^8.3.2",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^5.0.3"
  }
}
