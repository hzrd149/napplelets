{
  "name": "@napplelets/rubik-cube",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 3001 --strictPort",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "type-check": "tsc --noEmit",
    "verify": "pnpm test && pnpm type-check && pnpm build",
    "test": "vitest run",
    "test:conformance": "pnpm build && napplet-conformance ./dist",
    "test:conformance:ui": "napplet-conformance --ui . --exec \"vite build --watch\""
  },
  "dependencies": {
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@napplet/conformance-cli": "^0.2.19",
    "@napplet/vite-plugin": "^0.14.1",
    "@types/three": "^0.186.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^5.0.3"
  },
  "packageManager": "pnpm@10.8.0",
  "license": "MIT"
}
