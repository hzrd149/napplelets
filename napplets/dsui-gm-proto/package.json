    "timeago.js": "4.0.2"
  },
  "devDependencies": {
    "@napplet/vite-plugin": "^0.11.3",
    "@sveltejs/vite-plugin-svelte": "^7.2.0",
    "@tailwindcss/vite": "^4.1.18",
    "jsdom": "^26.1.0",
    "typescript": "^5.9.3",
    "vite": "^8.1.4",
    "vitest": "^4.1.10"
  }
}
