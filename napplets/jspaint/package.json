{
  "name": "jspaint",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "generate": "node scripts/build-upstream.mjs index.html",
    "dev": "pnpm generate && vite --host 127.0.0.1 --port 3001 --strictPort",
    "build": "pnpm generate && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "type-check": "tsc --noEmit",
    "verify": "pnpm type-check && pnpm build",
    "test:conformance": "pnpm build && napplet-conformance ./dist",
    "test:conformance:ui": "napplet-conformance --ui . --exec \"vite build --watch\""
  },
  "dependencies": {
    "@napplelets/theme-xp": "workspace:*",
    "@napplet/sdk": "^0.27.2"
  },
  "devDependencies": {
    "@napplet/conformance-cli": "^0.2.18",
    "@napplet/vite-plugin": "^0.14.1",
    "esbuild": "^0.25.12",
    "jspaint-upstream": "github:1j01/jspaint#53be67ab8c47cc0d2168899e7481bc04839c4c81",
    "typescript": "^5.9.3",
    "vite": "^6.4.2",
    "vite-plugin-singlefile": "^2.3.3"
  },
  "packageManager": "pnpm@10.8.0",
  "license": "MIT"
}
