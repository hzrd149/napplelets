{
  "name": "hashtree",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 3001 --strictPort",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "verify": "pnpm test && pnpm type-check && pnpm build",
    "test:conformance": "pnpm build && napplet-conformance ./dist",
    "test:conformance:ui": "napplet-conformance --ui . --exec \"vite build --watch\""
  },
  "dependencies": {
    "@napplelets/theme-dsui": "workspace:*",
    "@napplet/sdk": "^0.27.2",
    "@noble/ciphers": "^2.1.1",
    "@noble/hashes": "^2.2.0",
    "svelte": "^5.56.8"
  },
  "devDependencies": {
    "@napplet/conformance-cli": "^0.2.18",
    "@napplet/vite-plugin": "^0.14.1",
    "@sveltejs/vite-plugin-svelte": "^7.2.0",
    "jsdom": "^30.0.1",
    "typescript": "^7.0.2",
    "vite": "^8.2.0",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^4.1.10"
  },
  "packageManager": "pnpm@11.10.0",
  "license": "MIT"
}
